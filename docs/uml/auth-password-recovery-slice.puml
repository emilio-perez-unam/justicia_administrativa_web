@startuml
' Class diagram of the auth password-recovery slice (Phase 3.B).
' Pure class diagram: unquoted names + bodies (no quoted-generic/component mix).
title Auth password-recovery slice — domains/auth (Phase 3.B)

skinparam shadowing false
skinparam packageStyle rectangle

package "core/error" {
  class Result<T> <<sealed>>
  class Unit
  abstract class Failure <<sealed>>
}

package "domains/auth/domain" {
  class Password <<value object>> {
    +value: String
    +create(String): Result<Password>
  }
}

package "domains/auth/application" {
  interface AuthRepository <<port>> {
    +requestPasswordReset(email, redirectTo): Future<Result<Unit>>
    +updatePassword(newPassword): Future<Result<Unit>>
  }
  class RequestPasswordResetUseCase
  class ResetPasswordUseCase
  RequestPasswordResetUseCase --> AuthRepository
  ResetPasswordUseCase --> AuthRepository
  ResetPasswordUseCase ..> Password : validates
}

package "domains/auth/infrastructure" {
  class SupabaseAuthRepository
  class GoTrue <<Supabase>> {
    +resetPasswordForEmail(email, redirectTo)
    +updateUser(password)
  }
  SupabaseAuthRepository ..|> AuthRepository
  SupabaseAuthRepository --> GoTrue
}

package "domains/auth/actors" {
  class PasswordRecoveryActor <<ChangeNotifier>> {
    +phase: PasswordRecoveryPhase
    +failure: Failure?
    +requestReset(email)
    +submitNewPassword(pwd)
  }
  PasswordRecoveryActor --> RequestPasswordResetUseCase
  PasswordRecoveryActor --> ResetPasswordUseCase
}

package "lib/app/views" {
  class LoginView <<StatefulWidget>>
  class ResetPasswordView <<StatefulWidget>>
  LoginView --> PasswordRecoveryActor : requestReset (email dialog)
  ResetPasswordView --> PasswordRecoveryActor : submitNewPassword
  ResetPasswordView ..> GoTrue : onAuthStateChange(passwordRecovery)
}

AuthRepository ..> Unit
RequestPasswordResetUseCase ..> Failure : maps errors
@enduml
